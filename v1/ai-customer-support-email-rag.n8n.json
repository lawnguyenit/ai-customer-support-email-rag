    {
      "parameters": {
        "jsCode": "// Node 02: Sanitize and normalize email inputs\nconst item = $input.first().json;\n\n// Handle fields whether from Gmail trigger or Simulator webhook\nconst rawSubject = item.subject || (item.body && item.body.subject) || \"Support Inquiry\";\nconst rawBody = item.text || item.snippet || (item.body && item.body.body) || \"\";\nconst senderEmail = item.from || (item.body && item.body.sender_email) || \"customer@example.com\";\nconst senderName = item.sender_name || (item.body && item.body.sender_name) || senderEmail.split('@')[0];\nconst messageId = item.id || item.message_id || (item.body && item.body.message_id) || `<msg-${Date.now()}@agency.local>`;\nconst threadId = item.threadId || item.thread_id || (item.body && item.body.thread_id) || `thread_${Date.now()}`;\n\n// Clean Re: and Fwd: prefixes\nconst cleanSubject = rawSubject.replace(/^(Re:\\s*|Fwd:\\s*)+/gi, '').trim();\n\n// Strip quoted historical email threads and long signatures\nconst cleanBody = rawBody.split(/(?i)(^>|\\nOn .* wrote:|\\n---|\\nBest regards|\\nThanks,)/)[0].trim();\n\nreturn [{\n  json: {\n    message_id: messageId,\n    thread_id: threadId,\n    sender_email: senderEmail,\n    sender_name: senderName,\n    clean_subject: cleanSubject,\n    clean_body: cleanBody,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "c1000004-0004-4000-8000-000000000004",
      "name": "Sanitize & Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.1,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an incoming email classification engine for an agency support desk. Analyze the email subject and body. Return a JSON object with: 1. `is_support_request` (boolean: true if asking for technical help, billing, account access, bug reports, product usage; false if cold sales outreach, spam, recruitment, marketing pitch). 2. `category` (enum: 'technical_issue', 'billing_refund', 'account_access', 'feature_question', 'general_inquiry', 'non_support'). 3. `urgency` (enum: 'low', 'medium', 'high'). 4. `core_query` (distilled 1-2 sentence search phrase optimized for vector search).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Subject: \" + $json.clean_subject + \"\\n\\nBody: \" + $json.clean_body\n    }\n  ]\n}"
      },
      "id": "c1000005-0005-4000-8000-000000000005",
      "name": "OpenAI Intent Classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai_api_header_cred_id",
          "name": "OpenAI API Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse JSON payload from OpenAI Classifier\nconst raw = $input.first().json;\nconst prev = $('Sanitize & Normalize Email').first().json;\nlet parsedClassification = {};\n\ntry {\n  const contentStr = raw.choices[0].message.content;\n  parsedClassification = JSON.parse(contentStr);\n} catch (e) {\n  parsedClassification = {\n    is_support_request: true,\n    category: \"general_inquiry\",\n    urgency: \"medium\",\n    core_query: prev.clean_subject\n  };\n}\n\nreturn [{\n  json: {\n    ...prev,\n    classification: parsedClassification\n  }\n}];"
      },
      "id": "c1000006-0006-4000-8000-000000000006",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
