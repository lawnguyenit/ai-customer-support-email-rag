    {
      "parameters": {
        "jsCode": "// Evaluate vector search matches and extract highest similarity score\nconst pineconeResult = $input.first().json;\nconst prev = $('Parse Classification').first().json;\nconst threshold = parseFloat($('Workflow Settings & Thresholds').first().json.CONFIDENCE_THRESHOLD);\n\nconst matches = pineconeResult.matches || [];\nlet highestScore = 0.0;\nlet relevantSnippets = [];\n\nif (matches.length > 0) {\n  highestScore = matches[0].score || 0.0;\n  relevantSnippets = matches.map(m => (m.metadata && m.metadata.text) ? m.metadata.text : (m.text || \"\")).filter(t => t.length > 0);\n}\n\nreturn [{\n  json: {\n    ...prev,\n    highest_similarity_score: highestScore,\n    is_knowledge_sufficient: (highestScore >= threshold && relevantSnippets.length > 0),\n    knowledge_snippets: relevantSnippets\n  }\n}];"
      },
      "id": "c1000011-0011-4000-8000-000000000011",
      "name": "Evaluate Similarity & Gating",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        240
      ]
