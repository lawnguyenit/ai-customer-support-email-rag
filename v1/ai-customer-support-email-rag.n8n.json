        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an agency customer support assistant. Answer the customer's question strictly and accurately based ONLY on the provided knowledge base snippets. Format clearly with bullet points. If information is not in the knowledge snippets, do not speculate. Maintain a professional, polite, and reassuring tone. Sign off as 'Customer Support Team'.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer Name: \" + $json.sender_name + \"\\nCustomer Email: \" + $json.sender_email + \"\\nInquiry: \" + $json.clean_body + \"\\n\\nKnowledge Base Context:\\n\" + $json.knowledge_snippets.join('\\n---\\n')\n    }\n  ]\n}"
      },
      "id": "c1000013-0013-4000-8000-000000000013",
