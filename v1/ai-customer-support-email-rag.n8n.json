            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b1000012-0012-4000-8000-000000000012",
              "leftValue": "={{ $json.is_knowledge_sufficient }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
