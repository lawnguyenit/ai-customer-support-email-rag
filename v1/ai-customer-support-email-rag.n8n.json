      },
      "id": "c1000010-0010-4000-8000-000000000010",
      "name": "Pinecone Vector Query (RAG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        240
